generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlanId {
  tradara_pro_monthly
  tradara_pro_quarterly
  tradara_pro_annual
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  grace_period
  canceled
  expired
}

enum ChannelAccessStatus {
  pending_grant
  granted
  pending_revoke
  revoked
  error
}

enum AccessDesiredState {
  grant
  revoke
}

enum TelegramInviteStatus {
  pending
  issued
  consumed
  expired
  failed
}

enum WebhookProvider {
  telegram
  paymongo
  paypal
  xendit
  tradingview
}

enum TelegramExecutionStatus {
  idle
  attempting
  retrying
  succeeded
  failed_retryable
  failed_non_retryable
}

enum TelegramFailureKind {
  retryable
  non_retryable
}

enum TelegramLinkState {
  unlinked
  pending
  linked
}

enum AuditActorType {
  system
  admin
  job
  webhook
}

enum SignalStatus {
  draft
  ai_scored
  pending_review
  approved
  edited
  rejected
  published
  canceled
  watchlist
}

enum SignalSourceType {
  tradingview
  manual
  ai_assisted
}

enum TradeDirection {
  long
  short
  neutral
}

enum RiskLabel {
  low
  medium
  high
}

enum MarketInsightStatus {
  draft
  pending_review
  approved
  published
  rejected
  canceled
}

enum PublishRecommendation {
  review
  watchlist
  reject
}

enum MarketBias {
  bullish
  neutral
  bearish
}

enum ExecutionPosture {
  aggressive
  selective
  patient
  stand_down
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum UserMode {
  lite
  pro
}

enum LearningProgressStatus {
  not_started
  in_progress
  completed
}

enum TradeIdeaSetupType {
  breakout
  pullback
  range
  reversal
  continuation
  other
}

enum BeginnerSuitability {
  beginner
  intermediate
  advanced
}

enum AnalystReviewStatus {
  draft
  pending_review
  approved
  rejected
  published
  archived
}

enum TradeIdeaOutcomeStatus {
  open
  hit_target
  invalidated
  canceled
  timed_out
}

enum TradeLifecycleStatus {
  open
  closed
  canceled
}

enum UserEmotion {
  calm
  confident
  anxious
  fearful
  greedy
  frustrated
  uncertain
}

model User {
  id                 String                @id
  email              String?               @unique
  clerkUserId        String?               @unique
  displayName        String?
  telegramUserId     String?               @unique
  telegramLinkState  TelegramLinkState     @default(unlinked)
  telegramLinkedAt   DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  subscriptions      Subscription[]
  channelAccess      ChannelAccess[]
  auditLogs          AuditLog[]
  invites            TelegramInvite[]
  telegramLinkSessions TelegramLinkSession[]
  profile            UserProfile?
  lessonProgress     UserLessonProgress[]
  practiceAccounts   PracticeAccount[]
  practiceTrades     PracticeTrade[]
  tradeJournalEntries TradeJournalEntry[]
  personalTradingRules PersonalTradingRule[]
  riskDisclosureAcceptances RiskDisclosureAcceptance[]
  watchlistAssets    WatchlistAsset[]
  tradeIdeaBookmarks TradeIdeaBookmark[]
}

model TelegramLinkSession {
  id          String   @id
  userId      String
  clerkUserId String
  tokenHash   String   @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Subscription {
  id                     String             @id
  userId                 String
  planId                 SubscriptionPlanId
  status                 SubscriptionStatus
  providerName           WebhookProvider?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEndsAt    DateTime
  gracePeriodEndsAt      DateTime?
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelAccessRecords   ChannelAccess[]
}

model ChannelAccess {
  id                    String                  @id
  userId                String
  subscriptionId        String?
  channelId             String
  telegramUserId        String?
  status                ChannelAccessStatus
  desiredState          AccessDesiredState
  inviteId              String?
  lastSyncedAt          DateTime?
  lastError             String?
  lastErrorCode         String?
  lastFailureKind       TelegramFailureKind?
  executionStatus       TelegramExecutionStatus?
  executionAttempts     Int?
  lastExecutionAttemptAt DateTime?
  lastExecutionOutcomeAt DateTime?
  lastCorrelationId     String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription          Subscription?           @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invites               TelegramInvite[]
}

model TelegramInvite {
  id         String               @id
  accessId   String?
  userId     String
  channelId  String
  inviteUrl  String?
  status     TelegramInviteStatus
  expiresAt  DateTime?
  note       String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  access     ChannelAccess?       @relation(fields: [accessId], references: [id], onDelete: SetNull)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id              String          @id
  provider        WebhookProvider
  providerEventId String
  payloadHash     String
  signatureValid  Boolean
  processedAt     DateTime?
  receivedAt      DateTime        @default(now())

  @@unique([provider, providerEventId])
}

model AuditLog {
  id         String         @id
  userId     String?
  actorType  AuditActorType
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json
  createdAt  DateTime       @default(now())
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SignalInput {
  id                    String            @id
  sourceType            SignalSourceType
  sourceProvider        WebhookProvider?
  sourceEventId         String?
  symbol                String
  timeframe             String?
  direction             TradeDirection?
  entryZoneLow          Decimal?
  entryZoneHigh         Decimal?
  stopLoss              Decimal?
  takeProfit1           Decimal?
  takeProfit2           Decimal?
  takeProfit3           Decimal?
  marketPrice           Decimal?
  trendAlignment        Int?
  structureQuality      Int?
  volatilityQuality     Int?
  liquidityQuality      Int?
  riskRewardQuality     Int?
  conflictPenalty       Int?
  note                  String?
  strategyName          String?
  detectedAt            DateTime?
  metadata              Json
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  signal                Signal?

  @@index([sourceType, createdAt])
  @@index([sourceProvider, sourceEventId])
}

model Signal {
  id                    String            @id
  signalInputId         String            @unique
  status                SignalStatus
  sourceType            SignalSourceType
  confidenceScore       Int?
  setupQualityScore     Int?
  riskLabel             RiskLabel?
  publishRecommendation PublishRecommendation?
  invalidationSummary   String?
  setupRationale        String?
  marketContext         String?
  warnings              Json
  confidenceBreakdown   Json
  telegramDraft         String?
  expertReviewNotes     String?
  editedTelegramDraft   String?
  publishedTelegramText String?
  publishedTelegramChatId String?
  publishedTelegramMessageId String?
  approvedBy            String?
  approvedAt            DateTime?
  rejectedBy            String?
  rejectedAt            DateTime?
  publishedBy           String?
  publishedAt           DateTime?
  canceledAt            DateTime?
  metadata              Json
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  signalInput           SignalInput       @relation(fields: [signalInputId], references: [id], onDelete: Cascade)
  reviews               SignalReview[]

  @@index([status, createdAt])
}

model SignalReview {
  id                String        @id
  signalId          String
  reviewerId        String
  resultingStatus   SignalStatus
  notes             String?
  editedTelegramDraft String?
  createdAt         DateTime      @default(now())
  signal            Signal        @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId, createdAt])
  @@index([reviewerId, createdAt])
}

model MarketInsight {
  id                  String              @id
  status              MarketInsightStatus
  symbol              String
  timeframe           String?
  title               String
  summary             String
  body                String
  btcBias             MarketBias
  ethBias             MarketBias
  altcoinBias         MarketBias
  riskEnvironment     RiskLabel
  executionPosture    ExecutionPosture
  warnings            Json
  telegramDraft       String?
  approvedBy          String?
  approvedAt          DateTime?
  publishedBy         String?
  publishedAt         DateTime?
  rejectedBy          String?
  rejectedAt          DateTime?
  canceledAt          DateTime?
  metadata            Json
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, createdAt])
}

model UserProfile {
  id                    String          @id
  userId                String          @unique
  experienceLevel       ExperienceLevel?
  riskProfile           Json
  mode                  UserMode        @default(lite)
  onboardingCompleted   Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningPath {
  id               String          @id
  title            String
  level            ExperienceLevel
  description      String
  sortOrder        Int             @default(0)
  published        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lessons          Lesson[]
}

model Lesson {
  id               String          @id
  pathId           String
  title            String
  slug             String          @unique
  content          String
  level            ExperienceLevel
  sortOrder        Int             @default(0)
  estimatedMinutes Int             @default(5)
  published        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  path             LearningPath    @relation(fields: [pathId], references: [id], onDelete: Cascade)
  quiz             Quiz?
  progress         UserLessonProgress[]
}

model Quiz {
  id               String          @id
  lessonId         String          @unique
  questions        Json
  passingScore     Int             @default(70)
  published        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lesson           Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model UserLessonProgress {
  id               String                  @id
  userId           String
  lessonId         String
  status           LearningProgressStatus  @default(not_started)
  score            Int?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson           Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model GlossaryTerm {
  id                 String          @id
  term               String          @unique
  simpleDefinition   String
  advancedDefinition String?
  examples           Json
  relatedTerms       Json
  published          Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model PracticeAccount {
  id               String          @id
  userId           String
  virtualBalance   Decimal         @default(0)
  currency         String          @default("USD")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades           PracticeTrade[]

  @@index([userId, createdAt])
}

model TradeIdea {
  id                       String               @id
  sourceSignalId           String?              @unique
  asset                    String
  pair                     String
  bias                     MarketBias
  setupType                TradeIdeaSetupType
  timeframe                String
  entryZoneLow             Decimal
  entryZoneHigh            Decimal
  invalidationLevel        Decimal
  riskLevel                RiskLabel
  beginnerSuitability      BeginnerSuitability
  explanation              String
  whatCouldGoWrong         String
  aiConfidence             Int?
  analystStatus            AnalystReviewStatus  @default(draft)
  analystNotes             String?
  publishedAt              DateTime?
  outcomeStatus            TradeIdeaOutcomeStatus?
  outcomeSummary           String?
  publishedTelegramChatId  String?
  publishedTelegramMessageId String?
  metadata                 Json
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  practiceTrades           PracticeTrade[]
  journalEntries           TradeJournalEntry[]
  bookmarks                TradeIdeaBookmark[]
}

model TradeIdeaBookmark {
  id                String        @id
  userId            String
  tradeIdeaId       String
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeIdea         TradeIdea     @relation(fields: [tradeIdeaId], references: [id], onDelete: Cascade)

  @@unique([userId, tradeIdeaId])
}

model PracticeTrade {
  id               String              @id
  userId           String
  practiceAccountId String
  tradeIdeaId      String?
  asset            String
  pair             String
  direction        TradeDirection
  entryPrice       Decimal
  exitPrice        Decimal?
  size             Decimal
  stopLoss         Decimal?
  takeProfit       Decimal?
  status           TradeLifecycleStatus @default(open)
  pnl              Decimal?
  notes            String?
  openedAt         DateTime
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceAccount  PracticeAccount     @relation(fields: [practiceAccountId], references: [id], onDelete: Cascade)
  tradeIdea        TradeIdea?          @relation(fields: [tradeIdeaId], references: [id], onDelete: SetNull)
  journalEntries   TradeJournalEntry[]

  @@index([userId, openedAt])
}

model TradeJournalEntry {
  id               String          @id
  userId           String
  tradeIdeaId      String?
  practiceTradeId  String?
  title            String
  notes            String
  emotion          UserEmotion?
  mistakeTags      Json
  ruleFollowed     Boolean?
  lessonsLearned   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeIdea        TradeIdea?      @relation(fields: [tradeIdeaId], references: [id], onDelete: SetNull)
  practiceTrade    PracticeTrade?  @relation(fields: [practiceTradeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model PersonalTradingRule {
  id               String          @id
  userId           String
  rule             String
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RiskDisclosureAcceptance {
  id               String          @id
  userId           String
  disclosureVersion String
  acceptedAt       DateTime
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, acceptedAt])
}

model WatchlistAsset {
  id               String          @id
  userId           String
  asset            String
  pair             String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pair])
}
